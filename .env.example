# Food2U – WSU configuration
# Copy this file to `.env` and fill in your own values.
# NEVER commit your real .env file or share these secrets.

# Get your bot token from @BotFather on Telegram.
BOT_TOKEN=123456789:your-telegram-bot-token-here

# Comma-separated Telegram user IDs that should have admin access.
ADMIN_IDS=000000000

# Path to the SQLite database file (created automatically on first run).
DB_PATH=food2u.sqlite3

# Optional but recommended: enforce channel subscription before using the bot.
# Examples:
#   OFFICIAL_CHANNEL=@Food2U_WSU
#   OFFICIAL_CHANNEL=-1001234567890
OFFICIAL_CHANNEL=

# Optional: link shown to users (if OFFICIAL_CHANNEL is an ID with no public @username).
#   OFFICIAL_CHANNEL_JOIN_URL=https://t.me/Food2U_WSU
OFFICIAL_CHANNEL_JOIN_URL=

# Optional: logging verbosity (DEBUG, INFO, WARNING, ERROR). Defaults to INFO.
LOG_LEVEL=INFO
